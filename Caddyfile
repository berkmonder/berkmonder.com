# Serves the built site. HTTPS, compression and the domain are the server's front Caddy's job.
:80 {
	root * /srv
	# Pages and other files keep their names: browsers ask again each time (a quick "not modified" when
	# nothing changed), so a deploy shows at once. Without this, a browser may reuse an old page for days.
	@named not path /_astro/*
	header @named Cache-Control "no-cache"
	# Build output with a content hash in its name never changes: browsers keep it for a year.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
