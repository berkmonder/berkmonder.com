---
import { mailto, nav, site, socials } from "../site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
---

<footer class="site-footer">
	<div class="wrap cols">
		<div class="brand">
			<Logo />
			<p class="muted">
				{site.role} in {site.location}. Consulting, builds and training for AI in production.
			</p>
		</div>
		<nav aria-label="Footer">
			<h2>Site</h2>
			<ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
		</nav>
		<div>
			<h2>Contact</h2>
			<ul>
				<li>
					<a href={mailto()}><Icon name="mail" size={16} /> {site.email}</a>
				</li>
				{
					socials.map((s) => (
						<li>
							<a href={s.href} rel="me">
								<Icon name={s.icon} size={16} /> {s.label}
							</a>
						</li>
					))
				}
				<li>
					<a href={site.resume}><Icon name="file-text" size={16} /> CV (PDF)</a>
				</li>
			</ul>
		</div>
	</div>
	<div class="wrap base muted">© {new Date().getFullYear()} {site.fullName}</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--surface);
		padding-top: 3rem;
		margin-top: 4rem;
	}
	.cols {
		display: grid;
		grid-template-columns: 2fr 1fr 1.4fr;
		gap: 2rem;
	}
	.brand p {
		margin-top: 0.75rem;
		max-width: 22rem;
		font-size: 0.95rem;
	}
	h2 {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--muted);
		margin-bottom: 0.9rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
		font-size: 0.95rem;
	}
	ul a {
		color: var(--text-2);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		overflow-wrap: anywhere;
	}
	ul a:hover {
		color: var(--accent);
	}
	.base {
		font-size: 0.85rem;
		padding-block: 2rem;
		margin-top: 2rem;
		border-top: 1px solid var(--border);
	}
	@media (max-width: 44rem) {
		.cols {
			grid-template-columns: 1fr 1fr;
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
</style>
