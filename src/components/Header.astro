---
import { mailto, nav } from "../site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const current = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
	<div class="wrap bar">
		<Logo />
		<nav class="desktop-nav" aria-label="Main">
			{
				nav.map((item) => (
					<a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="end">
			<ThemeToggle />
			<a class="btn btn-primary cta" href={mailto("Working together")}>Get in touch</a>
			<button class="menu-button" type="button" popovertarget="mobile-nav" aria-label="Open the menu">
				<Icon name="menu" size={22} />
			</button>
		</div>
	</div>
	<nav id="mobile-nav" popover aria-label="Main">
		{
			nav.map((item) => (
				<a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
					{item.label}
				</a>
			))
		}
		<a class="btn btn-primary" href={mailto("Working together")}>Get in touch</a>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--header-h);
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		height: 100%;
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.desktop-nav {
		display: flex;
		gap: 0.25rem;
		margin-left: auto;
	}
	.desktop-nav a,
	#mobile-nav a:not(.btn) {
		color: var(--text-2);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
	}
	.desktop-nav a:hover,
	.desktop-nav a[aria-current="page"] {
		color: var(--text);
		background: var(--surface-2);
	}
	.end {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.cta {
		padding: 0.55rem 1rem;
		font-size: 0.9rem;
	}
	.menu-button {
		display: none;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: var(--surface);
		color: var(--text);
		cursor: pointer;
	}
	#mobile-nav {
		position: fixed;
		inset: var(--header-h) 0 auto 0;
		width: 100%;
		margin: 0;
		padding: 1rem var(--gutter) 1.5rem;
		border: 0;
		border-bottom: 1px solid var(--border);
		background: var(--bg);
		color: var(--text);
		box-shadow: var(--shadow);
	}
	#mobile-nav:popover-open {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	#mobile-nav a:not(.btn) {
		font-size: 1.05rem;
		padding: 0.75rem 0.5rem;
		border-radius: var(--radius-sm);
	}
	#mobile-nav a[aria-current="page"] {
		color: var(--accent);
	}
	#mobile-nav .btn {
		justify-content: center;
		margin-top: 0.75rem;
	}
	@media (max-width: 54rem) {
		.desktop-nav,
		.cta {
			display: none;
		}
		.menu-button {
			display: inline-grid;
		}
		.end {
			margin-left: auto;
		}
	}
</style>
