---
// An icon from Lucide (default) or Simple Icons, inlined as SVG at build time.
import { getIconData, iconToSVG, replaceIDs } from "@iconify/utils";
import lucide from "@iconify-json/lucide/icons.json";
import simple from "@iconify-json/simple-icons/icons.json";

interface Props {
	name: string;
	set?: "lucide" | "simple";
	size?: number;
	class?: string;
	/** Read out by screen readers; without it the icon is decorative. */
	label?: string;
}

const {
	name,
	set = "lucide",
	size = 20,
	class: className,
	label,
} = Astro.props;
const data = getIconData(set === "lucide" ? lucide : simple, name);
if (!data) throw new Error(`Unknown icon: ${set}:${name}`);
const svg = iconToSVG(data, { width: size, height: size });
---

<svg
	{...svg.attributes}
	class={className}
	role={label ? "img" : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : "true"}
	set:html={replaceIDs(svg.body)}
/>
