---
// The menu on the left of every page: the logo (home), the numbered pages (press 1–4 to go there), and
// at the bottom my links, the status, the language, the theme and llms.txt. On phones it folds into a
// bar at the top with a menu button.
import { type Lang, path, words } from "../i18n";
import StatusLink from "./StatusLink.astro";
import ThemeButton from "./ThemeButton.astro";

interface Props {
	lang: Lang;
	/** This page in the other language, if it has one (Learn and the blog are Turkish only). */
	otherLanguage?: string;
}
const { lang, otherLanguage } = Astro.props;
const w = words[lang];
const here = Astro.url.pathname;
const current = (href: string) => here === href || here.startsWith(href);
---

<header class="rail">
	<a class="logo" href={path("/", lang)} aria-label={`Berk Önder: ${w.home}`}>
		<img src="/favicon.svg" alt="" width="28" height="28" />
		<span>Berk Önder</span>
	</a>
	<button class="menu-button" type="button" popovertarget="rail-menu" aria-label={w.menuButton}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
	</button>

	<div class="rail-menu" id="rail-menu" popover>
		<nav class="pages" aria-label={w.menuButton}>
			{
				w.menu.map((item, i) => (
					<a href={item.href} data-key={i + 1} aria-current={current(item.href) ? "page" : undefined}>
						<span class="key" aria-hidden="true">
							[{i + 1}]
						</span>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="foot">
			<a href="https://github.com/berkmonder" class="ext" target="_blank" rel="noopener"><span class="key" aria-hidden="true">[ ]</span>GitHub</a>
			<a href="https://www.linkedin.com/in/berkmonder" class="ext" target="_blank" rel="noopener"
				><span class="key" aria-hidden="true">[ ]</span>LinkedIn</a
			>
			{
				otherLanguage && (
					<a href={otherLanguage} hreflang={w.otherLanguage.lang} lang={w.otherLanguage.lang} class="ext">
						<span class="key" aria-hidden="true">
							[ ]
						</span>
						{w.otherLanguage.label}
					</a>
				)
			}
			<StatusLink lang={lang} />
			<div class="row">
				<ThemeButton label={w.theme} />
				<a href="/llms.txt" class="small">llms.txt</a>
			</div>
			<p class="small">© {new Date().getFullYear()} Berk Önder</p>
		</div>
	</div>
</header>

<script>
	// Number keys go to the numbered pages, unless you're typing.
	document.addEventListener("keydown", (event) => {
		const target = event.target as HTMLElement;
		if (event.metaKey || event.ctrlKey || event.altKey || target.closest("input, textarea, [contenteditable]")) return;
		const link = document.querySelector<HTMLAnchorElement>(`.rail a[data-key="${event.key}"]`);
		if (link) link.click();
	});
</script>

<style>
	.rail {
		position: fixed;
		inset: 0 auto 0 var(--edge); /* next to the page (site.css) */
		width: var(--rail);
		display: flex;
		flex-direction: column;
		gap: 3rem;
		height: 100vh;
		padding: 2rem 1rem; /* the same inset as Learn's menu */
		font-family: var(--mono);
		font-size: 1.0625rem;
	}
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--strong);
		text-decoration: none;
	}
	.rail-menu {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		flex: 1;
		gap: 3rem;
	}
	.pages,
	.foot {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.pages a,
	.ext {
		color: var(--nav);
		text-decoration: none;
		padding-block: 0.15rem;
	}
	.key {
		display: inline-block;
		min-width: 2.25rem;
		color: var(--faint);
	}
	.pages a:hover,
	.ext:hover,
	.pages a[aria-current="page"] {
		color: var(--strong);
	}
	.pages a:hover .key,
	.pages a[aria-current="page"] .key {
		color: var(--accent);
	}
	.foot {
		font-size: 0.9375rem;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 0.75rem;
		color: var(--nav);
	}
	.small {
		font-size: 0.8125rem;
		color: var(--faint);
	}
	a.small:hover {
		color: var(--strong);
	}
	.menu-button {
		display: none;
	}

	/* Phones: a bar at the top; the menu opens over the page */
	@media (max-width: 52rem) {
		.rail {
			position: sticky;
			inset: auto;
			width: auto;
			z-index: 20;
			height: auto;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 0.9rem 1rem;
			background: var(--bg);
			border-bottom: 1px solid var(--line);
		}
		.menu-button {
			display: grid;
			place-items: center;
			width: 2.5rem;
			height: 2.5rem;
			border: 1px solid var(--line-strong);
			border-radius: 4px;
			background: transparent;
			color: var(--strong);
		}
		.menu-button svg {
			width: 1.25rem;
			stroke: currentColor;
			stroke-width: 2;
			stroke-linecap: round;
		}
		.rail-menu {
			position: fixed;
			inset: 4.3rem 0 auto 0;
			margin: 0;
			width: 100%;
			max-height: calc(100dvh - 4.3rem);
			overflow-y: auto;
			padding: 1.5rem 1rem 2rem;
			border: 0;
			border-bottom: 1px solid var(--line);
			background: var(--bg);
			color: var(--nav);
			font-family: var(--mono);
		}
		.rail-menu:not(:popover-open) {
			display: none;
		}
	}

	/* Wide screens: the menu is always there, not a popover */
	@media (min-width: 52.01rem) {
		.rail-menu {
			position: static;
			inset: auto;
			margin: 0;
			padding: 0;
			border: 0;
			background: transparent;
			color: inherit;
			width: auto;
			height: auto;
			overflow: visible;
		}
		.rail-menu:not(:popover-open) {
			display: flex;
		}
	}
</style>
