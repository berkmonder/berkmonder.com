---
// One button for dark and light, used in the site's menu and in Learn's header. Until the visitor
// picks one, the theme follows their system's setting (the script in <head> chose it already).
interface Props {
	label?: string;
}
const { label = "Switch between dark and light" } = Astro.props;
---

<theme-button>
	<button type="button" aria-label={label} title={label}>
		<svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
		<svg class="sun" viewBox="0 0 24 24" aria-hidden="true"
			><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
			></path></svg
		>
	</button>
</theme-button>

<script>
	const root = document.documentElement;
	const key = "starlight-theme"; // the same choice for the site and Learn (Starlight reads this key)

	customElements.define(
		"theme-button",
		class extends HTMLElement {
			connectedCallback() {
				this.querySelector("button")?.addEventListener("click", () => {
					const theme = root.dataset.theme === "light" ? "dark" : "light";
					root.dataset.theme = theme;
					try {
						localStorage.setItem(key, theme);
					} catch {}
				});
			}
		},
	);
</script>

<style>
	button {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 4px;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}
	button:hover {
		border-color: currentColor;
	}
	svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	/* The icon shows the theme in use */
	:global([data-theme="light"]) .moon,
	:global([data-theme="dark"]) .sun {
		display: none;
	}
</style>
