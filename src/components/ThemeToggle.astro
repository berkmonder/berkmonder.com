---
// Switches light/dark and remembers it under Starlight's key, so /learn follows the same choice.
import Icon from "./Icon.astro";
---

<button type="button" class="theme-toggle" aria-label="Switch between light and dark theme">
	<Icon name="moon" class="to-dark" />
	<Icon name="sun" class="to-light" />
</button>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>(".theme-toggle")) {
		button.addEventListener("click", () => {
			const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem("starlight-theme", next);
			} catch {}
		});
	}
</script>

<style>
	.theme-toggle {
		display: inline-grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: var(--surface);
		color: var(--text-2);
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--text);
		border-color: var(--accent);
	}
	/* The icons are rendered by Icon.astro, outside this component's scope. */
	:global([data-theme="dark"] .theme-toggle .to-dark),
	:global([data-theme="light"] .theme-toggle .to-light) {
		display: none;
	}
</style>
