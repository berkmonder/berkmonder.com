---
import type { Work } from "../data/work";
import Icon from "./Icon.astro";

interface Props {
	item: Work;
}
const { item } = Astro.props;
const external = item.link?.href.startsWith("http");
---

<article class="card work-card">
	<p class="where">{item.where}</p>
	<h3>{item.title}</h3>
	<p class="summary">{item.summary}</p>
	{item.result && <p class="result"><Icon name="trending-down" size={16} /> {item.result}</p>}
	<ul class="tags">{item.stack.map((s) => <li>{s}</li>)}</ul>
	{
		item.link && (
			<a class="link" href={item.link.href} rel={external ? "noopener" : undefined}>
				{item.link.label} <Icon name="arrow-up-right" size={16} />
			</a>
		)
	}
</article>

<style>
	.work-card {
		display: flex;
		flex-direction: column;
	}
	.where {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
		margin-bottom: 0.5rem;
	}
	.summary {
		color: var(--text-2);
		font-size: 0.97rem;
	}
	.result {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		align-self: flex-start;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 0.25rem 0.65rem;
		border-radius: 999px;
	}
	.tags {
		margin-top: auto;
		padding-top: 0.75rem;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 1rem;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
	}
</style>
