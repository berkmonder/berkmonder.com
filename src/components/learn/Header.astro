---
// Learn's top row, arranged like opencode's docs: the logo (home) and the subject dropdown on the left;
// search, GitHub and the dark/light button on the right. (Starlight's own header, rearranged.)
import Search from "@astrojs/starlight/components/Search.astro";
import TopicsDropdown from "starlight-sidebar-topics-dropdown/TopicsDropdown.astro";
import ThemeButton from "../ThemeButton.astro";
---

<div class="learn-header">
	<div class="start">
		<a class="brand" href="/" aria-label="Berk Önder: ana sayfa">
			<img src="/favicon.svg" alt="" width="26" height="26" />
		</a>
		<div class="topics"><TopicsDropdown /></div>
	</div>
	<div class="end">
		<Search />
		<a class="icon" href="https://github.com/berkmonder" aria-label="GitHub" target="_blank" rel="noopener">
			<svg viewBox="0 0 24 24" aria-hidden="true"
				><path
					d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .6 1.4.2 2.4.1 2.7.7.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z"
					fill="currentColor"></path></svg
			>
		</a>
		<ThemeButton label="Koyu ve açık tema arasında geç" />
	</div>
</div>

<style>
	.learn-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 100%;
	}
	.start,
	.end {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.brand {
		display: flex;
	}
	.icon {
		display: flex;
		color: var(--sl-color-gray-2);
	}
	.icon:hover {
		color: var(--sl-color-white);
	}
	.icon svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.end :global(theme-button) {
		color: var(--sl-color-gray-2);
	}
	/* Phones: the subject dropdown is at the top of the menu instead (Sidebar.astro), GitHub in it too */
	@media (max-width: 50rem) {
		.topics,
		.icon {
			display: none;
		}
	}
	/* The search box: Starlight's button (its <site-search> around it takes no space of its own) */
	@media (min-width: 50rem) {
		.end :global(button[data-open-modal]) {
			width: 24rem;
			max-width: none;
		}
	}
	/* Wide screens, pages with contents: the row follows the page's three columns (learn.css), so the
	   search sits on top of the contents column */
	@media (min-width: 72rem) {
		:global([data-has-toc]) .learn-header {
			display: grid;
			/* the second column starts where the contents do (learn.css: --edge, --header-end) */
			grid-template-columns: 1fr calc(var(--sl-sidebar-width) + var(--edge) - var(--header-end));
		}
		:global([data-has-toc]) .end {
			gap: 0.75rem;
		}
		:global([data-has-toc]) .end :global(button[data-open-modal]) {
			flex: 1;
			width: auto;
		}
	}
</style>
