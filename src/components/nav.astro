---
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === "";

// On the home page, use bare #hash links so the IntersectionObserver scroll-spy
// can match them exactly. On every other page, use absolute paths so clicking
// them navigates back home and scrolls to the right section.
const navItems = [
  {
    label: "Home",
    href: isHome ? "#home" : "/#home",
    anchor: true,
    sectionId: "home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: "Projects",
    href: isHome ? "#projects" : "/#projects",
    anchor: true,
    sectionId: "projects",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: "Blog",
    href: "/blog",
    anchor: false,
    sectionId: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>`,
  },
  {
    label: "About",
    href: "/about",
    anchor: false,
    sectionId: null,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>`,
  },
];

// Pre-mark route-based items active at render time (About, Blog)
// Scroll-spy will handle the home-page anchor items at runtime
const getInitialActive = (item: (typeof navItems)[0]) => {
  if (item.anchor) return false; // handled by JS scroll-spy on home
  return currentPath.startsWith(item.href);
};
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[var(--background)] border border-1 border-transparent backdrop-blur-xl transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-[90%]"
  >
    <div class="container mx-auto flex justify-center items-center p-3">
      <ul
        class="flex w-full justify-between md:space-x-6 md:justify-center md:gap-10 gap-4"
      >
        {
          navItems.map((item) => (
            <li class="flex-1 md:flex-none">
              <a
                href={item.href}
                data-section={item.sectionId}
                class:list={[
                  "flex flex-col items-center gap-1 text-[var(--white-icon)] transition-colors text-xs md:text-base relative group",
                  getInitialActive(item) && "active",
                ]}
              >
                <div class="absolute -left-5 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 bg-[#A9FF5B] nav-indicator hidden md:block" />
                <span class="md:hidden flex items-center justify-center w-6 h-6">
                  <Fragment set:html={item.icon} />
                </span>
                <span class="hidden md:inline-block">{item.label}</span>
                <span class="md:hidden text-[10px] mt-0.5">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>

<style>
  nav {
    transform: translateX(-50%);
    background-color: var(--background);
    transition:
      background-color 0.3s ease,
      border-radius 0.3s ease,
      border-color 0.3s ease;
  }

  nav.scrolling {
    background-color: var(--component-bg);
    border-color: #ffffff10;
    border-radius: 9999px;
  }

  nav a.active .nav-indicator {
    transform: translateY(-50%) scale(1);
    opacity: 1;
  }

  nav a.active {
    color: white !important;
  }

  @media (max-width: 767px) {
    nav {
      width: 100% !important;
      transform: translateX(-50%);
      bottom: 0;
      left: 50%;
      position: fixed;
      border-radius: 1rem 1rem 0 0;
      border-color: #ffffff10;
    }

    nav.scrolling {
      border-radius: 1rem 1rem 0 0;
      background-color: var(--component-bg);
    }

    body {
      padding-bottom: 70px;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const maxScroll = 1000;
  let rafId: number | null = null;
  const isHome =
    window.location.pathname === "/" || window.location.pathname === "";

  // ── Scroll-shrink pill animation ──────────────────────────────────────────
  function updateNav() {
    if (window.scrollY > 0) {
      nav?.classList.add("scrolling");

      const scrollProgress = Math.min(window.scrollY / maxScroll, 1);
      const easeProgress = 1 - Math.pow(1 - scrollProgress, 4);

      // With 5 items, use a wider minimum
      const minWidth = 480;
      const maxWidth = window.innerWidth * 0.9;
      const currentWidth = maxWidth - (maxWidth - minWidth) * easeProgress;

      if (window.innerWidth >= 768) {
        nav?.style.setProperty("width", `${currentWidth}px`);
      }
    } else {
      nav?.classList.remove("scrolling");
      nav?.style.setProperty("width", "90%");
    }
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) rafId = requestAnimationFrame(updateNav);
    },
    { passive: true },
  );

  // ── Smooth scroll for pure #hash anchor links (home page only) ────────────
  if (isHome) {
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        e.preventDefault();
        const target = e.currentTarget as HTMLAnchorElement;
        const targetId = target.getAttribute("href")?.substring(1) ?? "";
        document
          .getElementById(targetId)
          ?.scrollIntoView({ behavior: "smooth" });
      });
    });
  }

  // ── Active dot logic ───────────────────────────────────────────────────────
  const allNavLinks = document.querySelectorAll("nav a");

  function setActive(link: Element) {
    allNavLinks.forEach((l) => l.classList.remove("active"));
    link.classList.add("active");
  }

  if (isHome) {
    // IntersectionObserver scroll-spy for the home page anchor sections
    const sections = document.querySelectorAll("section[id]");
    // Links that use bare #hash hrefs
    const anchorLinks = document.querySelectorAll("nav a[href^='#']");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            const activeLink = document.querySelector(
              `nav a[data-section="${id}"]`,
            );
            if (activeLink) setActive(activeLink);
          }
        });
      },
      { threshold: 0.5 },
    );

    sections.forEach((section) => observer.observe(section));

    // Also activate "Home" immediately on load (before scroll)
    const homeLink = document.querySelector('nav a[data-section="home"]');
    if (homeLink) homeLink.classList.add("active");
  }
  // Route-based pages (About, Blog, etc.) already get `active` class from
  // server-side render via class:list — no JS needed.
</script>
