---
// /learn's header, left: the site's mark and name (home), then "Learn" (the lessons' start).
---

<div class="site-title">
	<a href="/" class="home" aria-label="Berk Önder, home">
		<svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
			<circle cx="12" cy="16" r="8.5" fill="none" stroke="currentColor" stroke-width="2.5"></circle>
			<circle cx="20" cy="16" r="8.5" fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.55"
			></circle>
		</svg>
		<span translate="no">Berk Önder</span>
	</a>
	<span class="sep" aria-hidden="true">/</span>
	<a href="/learn" class="section">Learn</a>
</div>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
		white-space: nowrap;
		font-family: "Bricolage Grotesque Variable", var(--sl-font);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	a {
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.home {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}
	.home svg {
		flex: none;
		color: var(--sl-color-text-accent);
	}
	.sep {
		color: var(--sl-color-gray-4);
		font-weight: 400;
	}
	.section {
		color: var(--sl-color-text-accent);
	}
	@media (max-width: 30rem) {
		.home span {
			display: none;
		}
	}
</style>
