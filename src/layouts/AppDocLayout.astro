---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;

const pageTitle = frontmatter?.title || "Document";
const backUrl = frontmatter?.backUrl || "/apps";
const backText = frontmatter?.backText || "Back";
---

<Layout title={pageTitle}>
  <div style="margin-bottom: 2rem;">
    <a href={backUrl} style="text-decoration: none; color: var(--muted);">&larr; {backText}</a>
  </div>
  <article>
    <slot />
  </article>
</Layout>
