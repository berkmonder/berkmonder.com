---
import Layout from "./Layout.astro";
import Nav from "../components/nav.astro";
import Footer from "../components/footer.astro";

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | Muhammed Berk Önder`}>
  <Nav />
  <main class="max-w-3xl mx-auto py-24 md:py-36 px-4 min-h-[70vh]">
    <!-- Back link -->
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-sm text-[var(--white-icon)] hover:text-[var(--sec)] transition duration-200 mb-10 group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="w-4 h-4 group-hover:-translate-x-1 transition-transform duration-200"
      >
        <path
          d="M7.82843 10.9999H20V12.9999H7.82843L13.1924 18.3638L11.7782 19.778L4 11.9999L11.7782 4.22168L13.1924 5.63589L7.82843 10.9999Z"
        ></path>
      </svg>
      Back to Blog
    </a>

    <!-- Post header -->
    <div class="mb-10 space-y-3">
      <span
        class="text-xs text-[var(--sec)] border border-[var(--white-icon-tr)] px-3 py-1 rounded-full bg-[#181818]"
      >
        {frontmatter.date}
      </span>
      <h1 class="text-3xl md:text-4xl font-semibold text-[var(--white)] leading-tight">
        {frontmatter.title}
      </h1>
    </div>

    <!-- Post content -->
    <article class="prose-dark">
      <slot />
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .prose-dark {
    color: var(--white-icon);
    line-height: 1.8;
    font-size: 1rem;
  }

  .prose-dark h1,
  .prose-dark h2,
  .prose-dark h3,
  .prose-dark h4 {
    color: var(--white);
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .prose-dark h1 { font-size: 2rem; }
  .prose-dark h2 { font-size: 1.5rem; }
  .prose-dark h3 { font-size: 1.25rem; }

  .prose-dark p {
    margin-bottom: 1.25rem;
  }

  .prose-dark a {
    color: var(--sec);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-dark a:hover {
    opacity: 0.8;
  }

  .prose-dark code {
    background: #1e1e2e;
    color: #cba6f7;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-family: "JetBrains Mono", "Fira Code", monospace;
  }

  .prose-dark pre {
    background: #1414149c;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1rem;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose-dark pre code {
    background: transparent;
    padding: 0;
    font-size: 0.875rem;
    color: var(--white-icon);
  }

  .prose-dark ul,
  .prose-dark ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose-dark li {
    margin-bottom: 0.5rem;
  }

  .prose-dark blockquote {
    border-left: 3px solid var(--sec);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--white-icon);
    font-style: italic;
  }

  .prose-dark hr {
    border: none;
    border-top: 1px solid var(--white-icon-tr);
    margin: 2.5rem 0;
  }

  .prose-dark img {
    border-radius: 1rem;
    max-width: 100%;
    margin: 2rem auto;
    display: block;
  }

  .prose-dark strong {
    color: var(--white);
    font-weight: 600;
  }

  .prose-dark em {
    color: var(--sec);
  }
</style>
