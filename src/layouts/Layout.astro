---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta
      name="description"
      content="Muhammed Berk Önder - MLOps Engineer building scalable AI/ML systems and infrastructure."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link rel="canonical" href="https://berkmonder.com" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsEw09800kqc/qfdOUk14q0EWeK1t/70kLdEUT12L4sA92Hh1O6kK2A58Y"
      crossorigin="anonymous"
    />

    <meta property="og:title" content="Muhammed Berk Önder | MLOps Engineer" />
    <meta
      property="og:description"
      content="Portfolio of Muhammed Berk Önder, MLOps Engineer specializing in scalable AI/ML systems."
    />
    <meta property="og:url" content="https://berkmonder.com" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muhammed Berk Önder Portfolio" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Muhammed Berk Önder",
        "url": "https://berkmonder.com",
        "sameAs": [
          "https://github.com/berkmonder",
          "https://linkedin.com/in/berkmonder"
        ],
        "jobTitle": "MLOps Engineer",
        "description": "MLOps Engineer building scalable AI/ML systems and infrastructure."
      }
    </script>
  </head>
  <body class="bg-[--background] text-[var(--white)] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
    --component-bg: #141414;
    --line: #ffffff10;
    --container: #181818;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 12px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
  }

  ::-webkit-scrollbar-thumb {
    background: #2a2a2a;
    border-radius: 6px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  .cursor {
    color: var(--white);
    animation: smoothBlink 0.6s ease-in-out infinite;
    margin-left: 4px;
    display: inline-block;
  }

  @keyframes smoothBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
