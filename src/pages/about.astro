---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import Footer from "../components/footer.astro";
---

<Layout title="About | Muhammed Berk Önder">
  <Nav />
  <main class="max-w-4xl mx-auto py-24 md:py-36 px-4">
    <div class="space-y-6">
      <h1 class="text-4xl md:text-5xl font-medium text-[var(--white)]">
        About Me
      </h1>
      <p class="text-lg md:text-xl text-[var(--sec)] shiny-sec">
        MLOps Engineer @ Teknasyon | Physics M.Sc.
      </p>

      <div class="grid grid-cols-1 gap-6 pt-6">
        <div
          class="bg-[#1414149c] border border-[var(--white-icon-tr)] p-6 rounded-2xl space-y-4"
        >
          <p class="text-[var(--white-icon)] leading-relaxed">
            I'm an MLOps Engineer at Teknasyon, specializing in building
            scalable AI/ML systems, model serving pipelines, and cloud
            infrastructure.
          </p>
          <p class="text-[var(--white-icon)] leading-relaxed">
            I holds a Master's degree in Physics from İstanbul University. My
            background in theoretical and quantitative physics deeply drives my
            analytical approach to software architecture and machine learning
            engineering.
          </p>
        </div>

        <div
          class="bg-[#1414149c] border border-[var(--white-icon-tr)] p-6 rounded-2xl space-y-4"
        >
          <h2 class="text-2xl font-semibold text-[var(--white)]">
            Current Focus
          </h2>
          <p class="text-[var(--white-icon)] leading-relaxed">
            Currently, I am developing <a
              href="https://turquoise.berkmonder.com"
              class="text-[var(--sec)] underline">Turquoise</a
            >, a high-performance AI/ML model marketplace.
          </p>
          <p class="text-[var(--white-icon)] leading-relaxed">
            Beyond engineering, I love exploring the inner workings of the
            universe and cooking delicious cookies 🍪.
          </p>
        </div>

        <div
          class="bg-[#1414149c] border border-[var(--white-icon-tr)] p-6 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4"
        >
          <div>
            <h3 class="text-xl font-medium text-[var(--white)]">
              Get in touch
            </h3>
            <p class="text-sm text-[var(--white-icon)]">
              Feel free to reach out to discuss AI/ML, physics, or software
              engineering.
            </p>
          </div>
          <div class="flex gap-4">
            <a
              href="mailto:berkmonder@gmail.com"
              class="px-5 py-2.5 bg-[var(--sec)] text-[#101010] font-semibold rounded-xl hover:opacity-90 transition duration-200"
            >
              Email Me
            </a>
            <a
              href="/files/resume_muhammedBerkOnder.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 border border-[var(--white-icon-tr)] bg-[#141414] text-[var(--white)] rounded-xl hover:bg-[var(--white-icon-tr)] transition duration-200"
            >
              Résumé
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
