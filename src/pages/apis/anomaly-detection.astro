---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="./apis/anomaly-detection">
  <h1>
    <span id="typewriter" data-text="./apis/anomaly-detection"></span><span class="cursor">█</span>
  </h1>

  <section style="margin-bottom: 2rem;">
    <h2>Anomaly Detection API</h2>
    <p>A fast, scalable API designed to detect outliers in time-series data. Optimized for MLOps pipelines and real-time monitoring.</p>
    
    <div style="margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap;">
      <a
        href="https://rapidapi.com/berkonder/api/anomaly-detection"
        target="_blank"
        rel="noopener noreferrer"
        style="font-weight: bold; padding: 0.6rem 1.2rem; border: 1px solid var(--text); border-radius: 6px; text-decoration: none; color: var(--bg); background-color: var(--text); transition: opacity 0.2s ease;"
      >
        View on RapidAPI
      </a>
      <a
        href="#demo"
        style="font-weight: bold; padding: 0.6rem 1.2rem; border: 1px solid var(--muted); border-radius: 6px; text-decoration: none; color: var(--text); transition: background 0.2s ease;"
      >
        Try the Demo &darr;
      </a>
    </div>
  </section>

  <section style="margin-bottom: 3rem;">
    <h3>Quick Start (cURL)</h3>
    <p>Send your time-series array to the inference endpoint to receive anomalous indices along with confidence scores.</p>
    
    <pre style="background: var(--bg); border: 1px solid var(--muted); padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 0.9em; margin-bottom: 1.5rem;">
<code>curl --request POST \
  --url https://anomaly-detection.p.rapidapi.com/v1/detect \
  --header 'Content-Type: application/json' \
  --header 'X-RapidAPI-Key: YOUR_API_KEY' \
  --data '&lbrace;
    "data": [10.2, 11.5, 10.8, 10.9, 100.5, 11.1, 10.4],
    "sensitivity": 0.85
&rbrace;'</code></pre>

    <h4>Response</h4>
    <pre style="background: var(--bg); border: 1px solid var(--muted); padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 0.9em;">
<code>&lbrace;
  "status": "success",
  "anomalies": [
    &lbrace;
      "index": 4,
      "value": 100.5,
      "confidence": 0.992
    &rbrace;
  ],
  "processing_time_ms": 12.4
&rbrace;</code></pre>
  </section>

  <section id="demo" style="margin-bottom: 3rem;">
    <h3>Interactive Demo</h3>
    <p>
      This interactive Marimo notebook simulates the API's underlying algorithm (Isolation Forest) directly in your browser using WebAssembly.
      <strong>No data is sent to a server.</strong> It allows you to visualize how the engine classifies outliers under different noise levels.
    </p>
    
    <div style="border: 1px solid var(--muted); border-radius: 8px; overflow: hidden; height: 650px; background: var(--bg); margin-top: 1rem;">
      <iframe
        src="/demos/anomaly-demo.html"
        width="100%"
        height="100%"
        frameborder="0"
        title="Anomaly Detection Marimo WASM Demo"
      ></iframe>
    </div>
    <p style="font-size: 0.85em; color: var(--muted); text-align: center; margin-top: 0.5rem;">
      Interactive WASM Demo. Adjust sliders to tweak parameters.
    </p>
  </section>
</Layout>
