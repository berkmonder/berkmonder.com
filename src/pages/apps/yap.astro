---
import AppLayout from '../../layouts/AppLayout.astro';

const contents = [
  { title: "Privacy Policy", url: "/apps/yap/privacy", desc: "How we handle your data." },
  { title: "Terms of Service", url: "/apps/yap/terms", desc: "Rules and guidelines for using YAP." },
  { title: "Support", url: "/apps/yap/support", desc: "Get help, report bugs, or request features." },
  // Un-comment these when you are ready to make them public:
  // { title: "Press Kit", url: "/apps/yap/press", desc: "Downloadable assets and app info for media." },
  // { title: "Data Deletion Policy", url: "/apps/yap/deletion", desc: "How to delete your data." }
];
---

<AppLayout 
  appName="YAP"
  tagline="A smart, adaptable planner app that stays completely local. Your life, organized your way."
  playStoreUrl="https://play.google.com/store/apps/details?id=YOUR_PACKAGE_NAME_HERE"
>
  <section style="margin-bottom: 3rem;">
    <h3>Screenshots</h3>
    <div style="display: flex; gap: 1rem; overflow-x: auto; padding-bottom: 1rem; scroll-snap-type: x mandatory;">
      <!-- Change these src attributes to match your actual images when you add them to the public/ folder -->
      <img src="/yap-screenshot-1.png" alt="YAP Screenshot 1" style="height: 400px; border-radius: 8px; border: 1px solid var(--muted); scroll-snap-align: start;" />
      <img src="/yap-screenshot-2.png" alt="YAP Screenshot 2" style="height: 400px; border-radius: 8px; border: 1px solid var(--muted); scroll-snap-align: start;" />
      <img src="/yap-screenshot-3.png" alt="YAP Screenshot 3" style="height: 400px; border-radius: 8px; border: 1px solid var(--muted); scroll-snap-align: start;" />
    </div>
  </section>

  <h3>Resources</h3>
  <ul class="post-list">
    {contents.map(post => (
      <li>
        <a href={post.url}>{post.title}</a>
        <div>{post.desc}</div>
      </li>
    ))}
  </ul>
</AppLayout>
