---
import Layout from '../../layouts/Layout.astro';

const contents = [
  { title: "Privacy policy", date: "2026-04-19", url: "/apps/yap/privacy", desc: "Privacy policy for Google Play." },
];
---

<Layout title="./apps/YAP">
  <h1>
    <span id="typewriter" data-text="./apps/YAP"></span><span class="cursor">█</span> muhammed berk önder
  </h1>
  
  <ul class="post-list">
    {contents.map(post => (
      <li>
        <a href={post.url}>{post.title}</a>
        <span class="date">{post.date}</span>
        <div>{post.desc}</div>
      </li>
    ))}
  </ul>
</Layout>
