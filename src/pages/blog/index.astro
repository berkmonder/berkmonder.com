---
import { getCollection } from "astro:content";
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", (p) => !p.data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Blog" description="Notes on LLMs, agents, MLOps and running AI in production.">
	<section class="section">
		<div class="wrap">
			<span class="eyebrow">Blog</span>
			<h1>Writing</h1>
			<p class="lead">Notes on LLMs, agents, MLOps and running AI in production: what worked, what didn't, and why.</p>

			{
				posts.length === 0 ? (
					<div class="card empty">
						<Icon name="pen-line" size={22} />
						<p>
							The first posts are on their way. Meanwhile, the <a href="/learn">free lessons</a> are
							taking shape, and <a href="/rss.xml">the RSS feed</a> will tell you when something new is
							up.
						</p>
					</div>
				) : (
					<ul class="posts">
						{posts.map((p) => (
							<li>
								<a href={`/blog/${p.id}`}>
									<h2>{p.data.title}</h2>
									<p>{p.data.description}</p>
								</a>
								<time datetime={p.data.date.toISOString()}>
									{p.data.date.toLocaleDateString("en-GB", { dateStyle: "medium" })}
								</time>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>
</Base>

<style>
	.empty {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		margin-top: 2.5rem;
		max-width: 42rem;
		color: var(--text-2);
	}
	.empty :global(svg) {
		flex: none;
		color: var(--accent);
		margin-top: 0.2rem;
	}
	.posts {
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 0;
		max-width: 48rem;
	}
	.posts li {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.5rem 0;
		border-top: 1px solid var(--border);
	}
	.posts a {
		color: inherit;
		text-decoration: none;
	}
	.posts h2 {
		font-size: 1.3rem;
		margin-bottom: 0.3rem;
	}
	.posts a:hover h2 {
		color: var(--accent);
	}
	.posts p {
		color: var(--text-2);
		margin: 0;
	}
	.posts time {
		color: var(--muted);
		font-size: 0.9rem;
		white-space: nowrap;
	}
</style>
