---
// The blog (Turkish): every post with its date, newest first, filterable by tag (/blog/?tag=vps), and
// the RSS feed. The posts are src/content/blog/*.md; drafts show only in `pnpm dev`.
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";

const posts = (
	await getCollection("blog", (p) => import.meta.env.DEV || !p.data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const date = (d: Date) =>
	d.toLocaleDateString("tr-TR", {
		day: "numeric",
		month: "short",
		year: "numeric",
		timeZone: "UTC",
	});
---

<Site lang="tr" title="Blog" description="Yapay zekâ sistemleri kurarken ve işletirken öğrendiklerim: LLM'ler, ajanlar, MLOps, altyapı.">
	<h1>Blog</h1>
	<p class="lead">Yapay zekâ sistemleri kurarken ve işletirken öğrendiklerim: neyin işe yaradığı, neyin yaramadığı ve kendiniz nasıl kurarsınız.</p>

	<div class="bar">
		<div class="tags" role="group" aria-label="Etikete göre göster">
			<button type="button" data-tag="" aria-pressed="true">Hepsi</button>
			{tags.map((tag) => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
		</div>
		<a class="button" href="/blog/rss.xml">Abone ol (RSS)</a>
	</div>

	{
		posts.length > 0 ? (
			<ol class="posts">
				{posts.map((post) => (
					<li data-tags={post.data.tags.join(" ")}>
						<time datetime={post.data.date.toISOString().slice(0, 10)}>{date(post.data.date)}</time>
						<div>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							{post.data.draft && <span class="draft">taslak</span>}
							<p>{post.data.description}</p>
						</div>
					</li>
				))}
			</ol>
		) : (
			<p class="empty">Henüz yazı yok. İlkleri yolda: RSS ile abone olursanız çıktığında haberiniz olur.</p>
		)
	}
</Site>

<script>
	// The tag buttons: show only the posts with that tag, and keep it in the address (?tag=…).
	const buttons = document.querySelectorAll<HTMLButtonElement>(".tags button");
	const posts = document.querySelectorAll<HTMLLIElement>(".posts li");

	function show(tag: string) {
		for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.tag === tag));
		for (const p of posts) p.hidden = tag !== "" && !(p.dataset.tags ?? "").split(" ").includes(tag);
		const url = new URL(location.href);
		if (tag) url.searchParams.set("tag", tag);
		else url.searchParams.delete("tag");
		history.replaceState(null, "", url);
	}

	for (const b of buttons) b.addEventListener("click", () => show(b.dataset.tag ?? ""));
	const tag = new URLSearchParams(location.search).get("tag");
	if (tag) show(tag);
</script>

<style>
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-block: 2.5rem 1rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tags button {
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: 4px;
		background: transparent;
		color: var(--nav);
		font: 0.8125rem var(--mono);
		cursor: pointer;
	}
	.tags button:hover {
		border-color: var(--line-strong);
		color: var(--strong);
	}
	.tags button[aria-pressed="true"] {
		background: var(--strong);
		border-color: var(--strong);
		color: var(--bg);
	}
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts li {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 0.25rem 2rem;
		padding-block: 1.75rem;
		border-top: 1px solid var(--line);
	}
	.posts li[hidden] {
		display: none;
	}
	.posts time {
		padding-top: 0.2rem;
		font: 0.875rem var(--mono);
		color: var(--faint);
	}
	.posts a {
		font-family: var(--mono);
		font-size: 1.125rem;
		text-decoration: none;
	}
	.posts a:hover {
		text-decoration: underline;
	}
	.posts p {
		margin-top: 0.4rem;
		font-size: 1rem;
	}
	.draft {
		margin-left: 0.6rem;
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--warn);
		border-radius: 4px;
		color: var(--warn);
		font: 0.75rem var(--mono);
	}
	.empty {
		margin-top: 2rem;
	}
	@media (max-width: 40rem) {
		.posts li {
			grid-template-columns: 1fr;
		}
	}
</style>
