---
import Layout from "../layouts/Layout.astro";

const apps = [
  {
    title: "Turquoise - AI/ML Model Marketplace",
    date: "2026-08-02",
    url: "https://turquoise.berkmonder.com",
    desc: "A high-performance, multi-tenant AI/ML model marketplace.",
  },
];
---

<Layout title="./projects">
  <h1>
    <span id="typewriter" data-text="./projects"></span><span class="cursor"
      >█</span
    > muhammed berk önder
  </h1>

  <h2>Mobile Apps</h2>
  <ul class="post-list">
    {
      apps.map((post) => (
        <li>
          <a href={post.url}>{post.title}</a>
          <span class="date">{post.date}</span>
          <div>{post.desc}</div>
        </li>
      ))
    }
  </ul>
</Layout>
