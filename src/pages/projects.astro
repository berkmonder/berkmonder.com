---
import Layout from '../layouts/Layout.astro';

const apps = [
  { title: "YAP - Your Adaptive Planner", date: "2026-04-19", url: "/apps/yap", desc: "A smart, completely local planner app." },
];

const apis = [
  { title: "Anomaly Detection API", date: "2026-04-19", url: "/apis/anomaly-detection", desc: "Real-time anomaly detection for time-series data." },
];
---

<Layout title="./projects">
  <h1>
    <span id="typewriter" data-text="./projects"></span><span class="cursor">█</span> muhammed berk önder
  </h1>
  
  <h2>Mobile Apps</h2>
  <ul class="post-list">
    {apps.map(post => (
      <li>
        <a href={post.url}>{post.title}</a>
        <span class="date">{post.date}</span>
        <div>{post.desc}</div>
      </li>
    ))}
  </ul>

  <h2 style="margin-top: 3rem;">APIs</h2>
  <ul class="post-list">
    {apis.map(post => (
      <li>
        <a href={post.url}>{post.title}</a>
        <span class="date">{post.date}</span>
        <div>{post.desc}</div>
      </li>
    ))}
  </ul>
</Layout>
