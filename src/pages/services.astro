---
import ContactBand from "../components/ContactBand.astro";
import Icon from "../components/Icon.astro";
import { faq, services, steps } from "../data/services";
import Base from "../layouts/Base.astro";
---

<Base
	title="Services"
	description="Consulting, hands-on builds and team training for LLM and agent systems, ML infrastructure and MLOps."
>
	<section class="section page-head">
		<div class="wrap">
			<span class="eyebrow">Work with me</span>
			<h1>Consulting, builds and training for AI in production</h1>
			<p class="lead">
				I work with companies that want AI to do real work: reliably, measurably and at a cost they
				understand. I can build it with you, set up what it runs on, and teach your team to own it.
			</p>
		</div>
	</section>

	{
		services.map((s, i) => (
			<section class="section service" id={s.id}>
				<div class="wrap service-grid">
					<div>
						<div class="label">
							<span class="icon-badge">
								<Icon name={s.icon} size={22} />
							</span>
							<span class="eyebrow">
								{String(i + 1).padStart(2, "0")} · {s.verb}
							</span>
						</div>
						<h2>{s.title}</h2>
						<p class="lead">{s.short}</p>
					</div>
					<div class="card">
						<h3>Typical work</h3>
						<ul class="checks">
							{s.points.map((p) => (
								<li>
									<Icon name="check" size={18} />
									<span>{p}</span>
								</li>
							))}
						</ul>
						<p class="fit">
							<strong>A good fit if:</strong> {s.fit}
						</p>
					</div>
				</div>
			</section>
		))
	}

	<section class="section">
		<div class="wrap">
			<div class="section-head">
				<span class="eyebrow">How it works</span>
				<h2>From first call to handover</h2>
			</div>
			<ol class="steps">
				{
					steps.map((s, i) => (
						<li class="card">
							<span class="num">{i + 1}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="wrap faq-wrap">
			<div class="section-head">
				<span class="eyebrow">Questions</span>
				<h2>Frequently asked</h2>
			</div>
			<div class="faq">
				{
					faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<ContactBand />
</Base>

<style>
	.page-head {
		padding-bottom: 1rem;
	}
	.service {
		scroll-margin-top: var(--header-h);
	}
	.service-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.5rem, 5vw, 4rem);
		align-items: start;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
	}
	.label {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}
	.label > * {
		margin: 0;
	}
	.checks {
		list-style: none;
		padding: 0;
		margin: 0 0 1.25rem;
		display: grid;
		gap: 0.7rem;
	}
	.checks li {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		color: var(--text-2);
	}
	.checks :global(svg) {
		flex: none;
		color: var(--accent);
		margin-top: 0.25rem;
	}
	.fit {
		font-size: 0.95rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		color: var(--text-2);
	}
	.fit strong {
		color: var(--text);
	}
	.steps {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}
	.steps p {
		color: var(--text-2);
		font-size: 0.97rem;
	}
	.num {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-ink);
		font-weight: 700;
		margin-bottom: 1rem;
	}
	.faq-wrap {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 2rem;
	}
	.faq details {
		border-bottom: 1px solid var(--border);
		padding: 1.1rem 0;
	}
	.faq details:first-child {
		border-top: 1px solid var(--border);
	}
	.faq summary {
		cursor: pointer;
		font-weight: 600;
		list-style: none;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	.faq summary::after {
		content: "+";
		color: var(--accent);
		font-size: 1.3rem;
		line-height: 1;
	}
	.faq details[open] summary::after {
		content: "−";
	}
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq p {
		margin: 0.75rem 0 0;
		color: var(--text-2);
	}
	@media (max-width: 54rem) {
		.service-grid,
		.faq-wrap {
			grid-template-columns: 1fr;
		}
		.steps {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 34rem) {
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>
