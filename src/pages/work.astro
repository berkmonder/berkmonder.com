---
import ContactBand from "../components/ContactBand.astro";
import WorkCard from "../components/WorkCard.astro";
import { work } from "../data/work";
import Base from "../layouts/Base.astro";

const groups = [
	{
		title: "In industry",
		text: "Production systems in telecom and mobile apps.",
		items: work.filter((w) => w.kind === "employer"),
	},
	{
		title: "My own systems and open source",
		text: "What I build and run myself, some of it live on this site.",
		items: work.filter((w) => w.kind === "own"),
	},
];
---

<Base title="Work" description="LLM systems, anomaly detection, forecasting and ML infrastructure I've built.">
	<section class="section page-head">
		<div class="wrap">
			<span class="eyebrow">Work</span>
			<h1>Systems I've built</h1>
			<p class="lead">
				Since 2022 I've taken machine learning from idea to production: LLM assistants, anomaly
				detection, forecasting, and the pipelines and infrastructure underneath.
			</p>
		</div>
	</section>

	{
		groups.map((g) => (
			<section class="section">
				<div class="wrap">
					<div class="section-head">
						<h2>{g.title}</h2>
						<p class="muted">{g.text}</p>
					</div>
					<div class="grid">
						{g.items.map((item) => (
							<WorkCard item={item} />
						))}
					</div>
				</div>
			</section>
		))
	}

	<ContactBand title="Want something like this for your team?" />
</Base>

<style>
	.page-head {
		padding-bottom: 1rem;
	}
</style>
