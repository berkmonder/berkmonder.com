---
// The home page, in Turkish (/) and English (/en/). The text is here, the layout below it.
import { getCollection } from "astro:content";
import { type Lang, path } from "../i18n";
import Site from "../layouts/Site.astro";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;

const text = {
	en: {
		title: "I build AI systems that work in production.",
		lead: "I'm Berk, an AI/ML engineer in Istanbul. I build LLM systems and the infrastructure under them, and I write and teach about it, in Turkish.",
		learn: "Read the lessons",
		ask: "Ask Turquoise",
		whatLabel: "What I do",
		what: "Since 2022 I've taken machine learning from idea to production in telecom and mobile apps: assistants that answer from a company's own data, anomaly detection, forecasting, and the pipelines underneath.",
		items: [
			{
				title: "LLM systems",
				text: "RAG assistants and agents with tools, evaluated and traced.",
			},
			{
				title: "MLOps",
				text: "Pipelines, experiment tracking, CI/CD and serving for models.",
			},
			{
				title: "Infrastructure",
				text: "Linux, Nix and a home GPU server, all configured as code.",
			},
		],
		turquoiseLabel: "Turquoise",
		turquoise:
			"My assistant: an agent that runs on my own GPU, searches my CV and this site, and shows its thinking and tool calls as it answers.",
		turquoiseLink: "How it works",
		writingLabel: "Learn and blog",
		writing:
			"Lessons on LLMs and agents, MLOps and infrastructure, and a blog. Both in Turkish.",
		latest: "Latest posts",
		contactLabel: "Contact",
		contact: "Write to me about a project, a training or a role.",
	},
	tr: {
		title: "Üretimde çalışan yapay zekâ sistemleri kuruyorum.",
		lead: "Ben Berk, İstanbul'da yapay zekâ/ML mühendisiyim. LLM sistemlerini ve altındaki altyapıyı kuruyor, bunları Türkçe yazıp anlatıyorum.",
		learn: "Derslere bak",
		ask: "Turquoise'a sor",
		whatLabel: "Ne yapıyorum",
		what: "2022'den beri telekom ve mobil uygulamalarda makine öğrenmesini fikirden üretime taşıyorum: şirketin kendi verisinden cevap veren asistanlar, anomali tespiti, tahminleme ve bunların altındaki veri hatları.",
		items: [
			{
				title: "LLM sistemleri",
				text: "Değerlendirilen ve izlenen RAG asistanları, araç kullanan ajanlar.",
			},
			{
				title: "MLOps",
				text: "Modeller için veri hatları, deney takibi, CI/CD ve servis.",
			},
			{
				title: "Altyapı",
				text: "Linux, Nix ve evde bir GPU sunucusu; hepsi kodla tanımlı.",
			},
		],
		turquoiseLabel: "Turquoise",
		turquoise:
			"Asistanım: kendi GPU'mda çalışan, özgeçmişimde ve bu sitede arama yapan, cevap verirken düşüncelerini ve araç çağrılarını gösteren bir ajan.",
		turquoiseLink: "Nasıl çalışıyor",
		writingLabel: "Öğren ve blog",
		writing:
			"LLM'ler ve ajanlar, MLOps ve altyapı üzerine dersler ve bir blog. İkisi de Türkçe.",
		latest: "Son yazılar",
		contactLabel: "İletişim",
		contact: "Bir proje, eğitim ya da iş için yazabilirsiniz.",
	},
}[lang];

const posts = (
	await getCollection("blog", (p) => import.meta.env.DEV || !p.data.draft)
)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

// The chat on this page: its suggested questions (and button label).
const assistant = {
	en: {
		suggestions: [
			"What's on this site?",
			"What does Berk do?",
			"Which lessons are there?",
		],
	},
	tr: {
		suggestions: [
			"Bu sitede neler var?",
			"Berk ne iş yapıyor?",
			"Hangi dersler var?",
		],
	},
}[lang];
---

<Site lang={lang} assistant={assistant} otherLanguage={path("/", lang === "en" ? "tr" : "en")}>
	<section class="hero">
		<h1>{text.title}</h1>
		<p class="lead">{text.lead}</p>
		<div class="actions">
			<a class="button primary" href="/learn/">{text.learn}</a>
			<a class="button" href="#ask">{text.ask}</a>
		</div>
	</section>

	<section class="section">
		<h2>{text.whatLabel}</h2>
		<div class="body">
			<p>{text.what}</p>
			<div class="items">
				{
					text.items.map((item) => (
						<div>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<h2>{text.turquoiseLabel}</h2>
		<div class="body">
			<p>{text.turquoise}</p>
			<p><a href={path("/turquoise/", lang)}>{text.turquoiseLink} →</a></p>
		</div>
	</section>

	<section class="section">
		<h2>{text.writingLabel}</h2>
		<div class="body">
			<p>{text.writing}</p>
			<div class="actions">
				<a class="button" href="/learn/">Learn</a>
				<a class="button" href="/blog/">Blog</a>
			</div>
			{
				posts.length > 0 && (
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>

	<section class="section">
		<h2>{text.contactLabel}</h2>
		<div class="body">
			<p>{text.contact}</p>
			<p class="mono">
				<a href="mailto:berkmonder@gmail.com">berkmonder@gmail.com</a> ·
				<a href="https://www.linkedin.com/in/berkmonder">LinkedIn</a> ·
				<a href="https://github.com/berkmonder">GitHub</a> ·
				<a href="/files/resume_muhammedBerkOnder.pdf">CV</a>
			</p>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-block: 2rem 4rem;
	}
	.hero h1 {
		max-width: 20ch;
	}
	.posts {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
		font-family: var(--mono);
		font-size: 1rem;
	}
	.posts li + li {
		margin-top: 0.4rem;
	}
</style>
