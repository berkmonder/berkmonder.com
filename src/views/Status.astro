---
// The status page, in Turkish (/status/) and English (/en/status/). The board itself is
// src/components/Status.tsx (it fills itself in the browser from Upptime's data).
import StatusBoard from "../components/Status";
import { type Lang, path } from "../i18n";
import Site from "../layouts/Site.astro";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const text = {
	en: {
		title: "Status",
		note: "Checked every 5 minutes from GitHub's servers by Upptime. Full history:",
	},
	tr: {
		title: "Durum",
		note: "Upptime ile GitHub'ın sunucularından 5 dakikada bir kontrol ediliyor. Tüm geçmiş:",
	},
}[lang];

// The chat on this page: its suggested questions (and button label).
const assistant = {
	en: {
		suggestions: [
			"Is everything up right now?",
			"Is the GPU on?",
			"When was the last outage?",
		],
	},
	tr: {
		suggestions: [
			"Şu an her şey çalışıyor mu?",
			"GPU açık mı?",
			"Son kesinti ne zamandı?",
		],
	},
}[lang];
---

<Site lang={lang} assistant={assistant} title={text.title} otherLanguage={path("/status/", lang === "en" ? "tr" : "en")}>
	<StatusBoard client:load lang={lang} />
	<p class="note">{text.note} <a href="https://github.com/berkmonder/status" target="_blank" rel="noopener">github.com/berkmonder/status</a></p>
</Site>

<style>
	.note {
		margin-top: 3rem;
		font-size: 0.9375rem;
		color: var(--faint);
	}
</style>
